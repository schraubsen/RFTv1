table drumaccent 512 4806 256 ; Accent-Sequenzen
seq drumaccent ~1640 16 ; Drum Accent Steps
seq synthaccent ~1658 16 ; Synth Accent Steps

# Song-Tabelle (EMiX): 64 x 528 Byte ab 0x130000
table song 0x130000 528 64 ; Song (1..64)
field name ~0 ascii 8 ; Name
field tempo_whole ~8 u8 20 300 ; Tempo (ganz)
field tempo_dec ~9 u8 0 9 ; Tempo (Dezimal)
field length ~11 u8 0 255 ; Länge
field mute_hold ~12 u8 0=Off 1=On ; Mute Hold
field next_song ~13 u8 0 255 ; Next Song
field events ~14 u16be 0 20000 ; Anzahl Events (nur lesen empfohlen)

# FX (EMX-Pascal-Editor: FXbase 1674, 3 x 4 Byte)
table fx1 2186 4806 256 ; FX 1
field type ~0 u8 0 15 ; Effect Type
field edit1 ~1 u8 0 127 ; Edit 1
field edit2 ~2 u8 0 127 ; Edit 2
field motion ~3 u8 0=Off 1=On ; Motion Seq
table fx2 2190 4806 256 ; FX 2
field type ~0 u8 0 15 ; Effect Type
field edit1 ~1 u8 0 127 ; Edit 1
field edit2 ~2 u8 0 127 ; Edit 2
field motion ~3 u8 0=Off 1=On ; Motion Seq
table fx3 2194 4806 256 ; FX 3
field type ~0 u8 0 15 ; Effect Type
field edit1 ~1 u8 0 127 ; Edit 1
field edit2 ~2 u8 0 127 ; Edit 2
field motion ~3 u8 0=Off 1=On ; Motion Seq

# UNBESTÄTIGT (abgeleitet, keine Quelle): Synth-Part = 20 Byte Kopf + 128 Noten + 128 Gates (276 Byte, analog ESX-Keyboard)
table synthseq1 770 4806 256 ; Synth 1 Sequenz (unbestätigt)
arr notes 20 128 0 255 ; Noten pro Step (unbestätigt)
arr gates 148 128 0 255 ; Gates pro Step (unbestätigt)
table synthseq2 1046 4806 256 ; Synth 2 Sequenz (unbestätigt)
arr notes 20 128 0 255 ; Noten pro Step (unbestätigt)
arr gates 148 128 0 255 ; Gates pro Step (unbestätigt)
table synthseq3 1322 4806 256 ; Synth 3 Sequenz (unbestätigt)
arr notes 20 128 0 255 ; Noten pro Step (unbestätigt)
arr gates 148 128 0 255 ; Gates pro Step (unbestätigt)
table synthseq4 1598 4806 256 ; Synth 4 Sequenz (unbestätigt)
arr notes 20 128 0 255 ; Noten pro Step (unbestätigt)
arr gates 148 128 0 255 ; Gates pro Step (unbestätigt)
table synthseq5 1874 4806 256 ; Synth 5 Sequenz (unbestätigt)
arr notes 20 128 0 255 ; Noten pro Step (unbestätigt)
arr gates 148 128 0 255 ; Gates pro Step (unbestätigt)

# UNBESTÄTIGT: Motion = 24 x 130 Byte ab Pattern+1686 (1686+3120 = 4806 = Patterngröße)
table motion1 2198 4806 256 ; Motion 1 (unbestätigt)
field op 0 u16be 0 65535 ; Operation-Nr.
arr values 2 128 0 255 ; Werte (MSB=Off)
