# EMX-1 Schema. Quellen (nicht auf Hardware verifiziert; gegen 4 echte .EMX-Bänke plausibilisiert: 236 Felder, 0 Wertebereichs-Verstöße):
#  - themesser/EMiX (Dateigröße 0x1A8000, Song-Tabelle, Magic 'KORG..iEMX')
#  - BerndPeuser/Korg-EMX-Editor (Pattern ab 512, 4806 Byte/Pattern, Part-Offsets)
# ~ = Referenz, ! = Hardware-verifiziert, ohne Präfix = Vermutung. Step-Bits: Bit0 = Step 1 (Korg TABLE23).

table pattern 512 4806 256 ; Pattern (A01..D64)
field name ~0 ascii 8 ; Name
field tempo_bpm ~8 u16be @7:9 20 300 ; Tempo (BPM ganz)
field tempo_dec ~8 u16be @0:4 0 9 ; Tempo (Dezimalstelle)
field swing ~10 u8 0 25 ; Swing (50+x %)
field length ~11 u8 @0:4 0 15 ; Pattern-Länge
field beat ~11 u8 @4:2 0=16tel 1=32tel 2=8tel-Triole 3=16tel-Triole ; Beat
field roll ~11 u8 @6:2 0=2 1=3 2=4 ; Roll-Typ
field fxchain ~12 u8 0 3 ; FX-Kette
field laststep ~13 u8 0 15 ; Last Step (0-15)
field arpscale ~14 u8 @0:5 0 30 ; Arp-Scale
field arpcenter ~15 u8 0 127 ; Arp Center Note

table drum1 536 4806 256 ; Drum 1
field sample ~0 u8 0 255 ; Sample (Bank-Nr.)
field pitch ~1 u8 0 127 ; Pitch (64=Original)
field level ~2 u8 0 127 ; Level
field pan ~3 u8 0 127 ; Pan (64=Center)
field egtime ~4 u8 0 127 ; EG Time
field fxselect ~5 u8 @0:2 0 2 ; FX Select (0=FX1..2=FX3)
field fxsend ~5 u8 @2:1 0=Off 1=On ; FX Send
field roll ~5 u8 @3:1 0=Off 1=On ; Roll
field ampeg ~5 u8 @4:1 0=Gate 1=EG ; Amp EG
field modspeed ~7 u8 0 127 ; Mod Speed
field moddepth ~8 u8 0 127 ; Mod Depth (64=0)
field motionseq ~9 u8 0 2 ; Motion Seq (0=Off,1=Smooth,2=TrigHold)
seq steps ~10 16 ; Step-Sequenz (128 Steps)

table drum2 562 4806 256 ; Drum 2
field sample ~0 u8 0 255 ; Sample (Bank-Nr.)
field pitch ~1 u8 0 127 ; Pitch (64=Original)
field level ~2 u8 0 127 ; Level
