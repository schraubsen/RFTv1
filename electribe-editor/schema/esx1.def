# ESX-1 Schema. Vertrauen: ~ = Referenz (Korg ESX1midiimp.txt TABLE4-13 + lammas/electribe), gegen Standard-default.esx plausibilisiert,
# NICHT von uns auf Hardware verifiziert. ! = Hardware-verifiziert. Ohne Präfix = Vermutung.
# Direktiven: table / field / seq (Step-Bits, Bit0 = Step 1) / arr (Byte-Array). Nicht abgedeckt: Motion-Sequenzen (TABLE12), Song-Events.

table global 0x20 192 1 ; Global (192 Byte ab 0x20)
field memprotect ~0 u8 0=Off 1=On ; Memory Protect
field arpcontrol ~2 u8 0=Normal 1=Reverse ; Arp Control
field audioinmode ~3 u8 0=L/Mono 1=Stereo ; Audio-In Mode
field midiclock ~4 u8 0=Int 1=Ext 2=Auto ; MIDI Clock
field pitchbend ~6 u8 0 24 ; Pitch Bend Range (12 = keine)

table pattern 0x200 4280 256 ; Pattern (A01..D64)
field name ~0 ascii 8 ; Name
field tempo_bpm ~8 u16be @7:9 20 300 ; Tempo (BPM ganz)
field tempo_dec ~8 u16be @0:4 0 9 ; Tempo (Dezimalstelle)
field swing ~10 u8 0 25 ; Swing (50+x %)
field length ~11 u8 @0:3 0 7 ; Pattern-Länge (0-7 = 1-8 Takte)
field beat ~11 u8 @4:2 0=16tel 1=32tel 2=8tel-Triole 3=16tel-Triole ; Beat
field roll ~11 u8 @6:2 0=2 1=3 2=4 ; Roll-Typ
field fxchain ~12 u8 0=None 1=1-2 2=2-3 3=1-2-3 ; FX-Kette
field laststep ~13 u8 0 15 ; Last Step (0-15)
field arpscale ~14 u8 @0:5 0 30 ; Arp-Scale (0=Chromatic .. 30=Octave)
field arpcenter ~15 u8 0 127 ; Arp Center Note
field mutestatus ~16 u16le 0 65535 ; Part Mute/Solo Status (Bitmaske)
field swingstatus ~18 u16le 0 65535 ; Part Swing Status (Bitmaske)
field outbus ~20 u16le 0 65535 ; Part OutputBus Status (Bitmaske)
field accentstatus ~22 u16le 0 65535 ; Part Accent Status (Bitmaske)

table drum1 0x218 4280 256 ; Drum Part 1
field sample ~0 u16be @0:15 0 999 ; Sample-Nr.
field sample_off ~0 u16be @15:1 0=Aktiv 1=OFF ; Sample OFF
field slice ~2 u8 0 255 ; Slice No. (MSB=ALL)
field filtertype ~4 u8 0=LPF 1=HPF 2=BPF 3=BPF+ ; Filter Type
field cutoff ~5 u8 0 127 ; Cutoff
field reso ~6 u8 0 127 ; Resonance
field egint ~7 u8 0 127 ; EG Int (64=0)
field pitch ~8 u8 0 127 ; Pitch (64=Original)
field level ~9 u8 0 127 ; Level
field pan ~10 u8 0 127 ; Pan (64=Center)
field egtime ~11 u8 0 127 ; EG Time
field start ~12 u8 0 127 ; Start Point
field fxselect ~13 u8 @0:2 0 2 ; FX Select (0=FX1..2=FX3)
field fxsend ~13 u8 @2:1 0=Off 1=On ; FX Send
field roll ~13 u8 @3:1 0=Off 1=On ; Roll
field ampeg ~13 u8 @4:1 0=Gate 1=EG ; Amp EG
field reverse ~13 u8 @5:1 0=Off 1=On ; Reverse
field moddest ~14 u8 @0:3 0=Pitch 1=Cutoff 2=Amp 3=Pan ; Mod Dest
field modtype ~14 u8 @4:3 0=Saw 1=Squ 2=Tri 3=S&H 4=EG ; Mod Type
field bpmsync ~14 u8 @7:1 0=Off 1=On ; BPM Sync
field modspeed ~15 u8 0 127 ; Mod Speed
field moddepth ~16 u8 0 127 ; Mod Depth (64=0)
field motionseq ~17 u8 0=Off 1=Smooth 2=TrigHold ; Motion Seq
seq steps ~18 16 ; Step-Sequenz (128 Steps)

