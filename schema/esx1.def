# ESX-1 (.esx) – Datei-Layout
# Quelle: Open Electribe Editor 1.0.0 (skratchdot.com, EPL-1.0). Aus dem Bytecode der Klassen EsxUtil und *Impl abgeleitet.
# Kein "!" = nicht von uns am Gerät verifiziert. Byte-Reihenfolge Big-Endian.
# Gegenprobe an 5 echten .esx (Werks- und Nutzerdaten): Namen, Tempi, Songs, Sample-Header plausibel.
# Steps: LSB = erster Step, statistisch belegt (Drum 1: 3960 Treffer auf Zählzeiten vs. 594/1591/904).
# Keyboard-Noten: Bit 7 gesetzt = Step aus, gestützt durch Verteilung (belegte Noten auf Zählzeiten, Bereich 16–101).
# Sample-Audio: 16-Bit-PCM Big-Endian ab @audio + off1start + 16 Byte Vorspann, Frames = end + 1; an 11 exportierten WAVs Sample für Sample bestätigt.
@magic 0x000000 KORG
@magic 0x000008 ESX
@magic 0x1B0000 KORG
@enum fx Reverb,BPM Sync Delay,Short Delay,Mod Delay,Grain Shifter,Cho/Flg,Phaser,Ring Mod,Talking Mod,Pitch Shifter,Compressor,Distortion,Decimator,EQ,LPF,HPF
@enum flt LPF,HPF,BPF,BPF+
@enum modtype Saw,Square,Triangle,S&H,Envelope
@enum moddest Pitch,Cutoff,Amp,Pan
@enum beat 16tel,32tel,8tel-Triole,16tel-Triole
@enum roll 2,3,4
@enum chain –,1→2,2→3,1→2→3
@enum fxsel FX1,FX2,FX3
@enum onoff aus,an
@enum ampeg Gate,EG
@enum arp Chromatic,Ionian,Dorian,Phrygian,Lydian,Mixolydian,Aeolian,Locrian,Major Blues,minor Blues,Diminish,Comb. Diminish,Major Penta,minor Penta,Raga Bhairav,Raga Gamanasrama,Raga Todi,Spanish,Gypsy,Arabian,Egyptian,Hawaiian,Bali Island,Miyakobushi,Ryukyu,Wholetone,m3rd,M3rd,4th,5th,Octave
@struct drum 34
+0 2 u16 sample
+2 1 u8 slice
+4 1 enum:flt filter
+5 1 u8 cutoff
+6 1 u8 resonance
+7 1 u8 egint
+8 1 s8 pitch
+9 1 u8 level
+10 1 u8 pan
+11 1 u8 egtime
+12 1 u8 start
+13 1 bits0-1:fxsel fxselect
+13 1 bits2:onoff fxsend
+13 1 bits3:onoff roll
+13 1 bits4:ampeg ampeg
+13 1 bits5:onoff reverse
+14 1 bits0-2:moddest moddest
+14 1 bits4-6:modtype modtype
+14 1 bits7:onoff bpmsync
+15 1 u8 modspeed
+16 1 u8 moddepth
+17 1 u8 motion
+18 16 steps steps
@end
@struct kbd 274
+0 2 u16 sample
+2 1 u8 slice
+4 1 u8 glide
+5 1 enum:flt filter
+6 1 u8 cutoff
+7 1 u8 resonance
+8 1 u8 egint
+9 1 u8 level
+10 1 u8 pan
+11 1 u8 egtime
+12 1 u8 start
+13 1 bits0-1:fxsel fxselect
+13 1 bits2:onoff fxsend
+13 1 bits3:onoff roll
+13 1 bits4:ampeg ampeg
+13 1 bits5:onoff reverse
+14 1 bits0-2:moddest moddest
+14 1 bits4-6:modtype modtype
+14 1 bits7:onoff bpmsync
+15 1 u8 modspeed
+16 1 u8 moddepth
+17 1 u8 motion
+18 128 bytes notes      # Bit 7 = Step aus, Bits 0-6 = MIDI-Note (statistisch gestützt)
+146 128 bytes gates
@end
@struct slice 32
+0 2 u16 sample
+2 1 enum:flt filter
+3 1 u8 cutoff
+4 1 u8 resonance
+5 1 u8 egint
+6 1 s8 pitch
+7 1 u8 level
+8 1 u8 pan
+9 1 u8 egtime
+10 1 u8 start
+11 1 bits0-1:fxsel fxselect
+11 1 bits2:onoff fxsend
+11 1 bits3:onoff roll
+11 1 bits4:ampeg ampeg
+11 1 bits5:onoff reverse
+12 1 bits0-2:moddest moddest
+12 1 bits4-6:modtype modtype
+12 1 bits7:onoff bpmsync
+13 1 u8 modspeed
+14 1 u8 moddepth
+15 1 u8 motion
+16 16 steps steps
@end
@struct audioin 156
+0 1 enum:flt filter
+1 1 u8 cutoff
+2 1 u8 resonance
+3 1 u8 egint
+4 1 u8 level
+5 1 u8 pan
+6 1 u8 egtime
+7 1 bits0-1:fxsel fxselect
+7 1 bits2:onoff fxsend
+7 1 bits3:onoff roll
+7 1 bits4:ampeg ampeg
+8 1 bits0-2:moddest moddest
+8 1 bits4-6:modtype modtype
+8 1 bits7:onoff bpmsync
+9 1 u8 modspeed
+10 1 u8 moddepth
+11 1 u8 motion
+12 16 steps steps
+28 128 bytes gates
@end
@struct accent 18
+0 1 u8 level
+1 1 u8 motion
+2 16 steps steps
@end
@struct fx 4
+0 1 enum:fx type
+1 1 u8 edit1
+2 1 u8 edit2
+3 1 u8 motion
@end
@struct motion 130
+0 2 u16 operation
+2 128 bytes values
@end
@struct pattern 4280
+0 8 str name
+8 2 tempo tempo
+10 1 u8 swing          # 0 = 50 %, 25 = 75 %
+11 1 bits0-2 length   # +1 = Takte
+11 1 bits4-5:beat beat
+11 1 bits6-7:roll rolltype
+12 1 enum:chain fxchain
+13 1 u8 laststep      # +1 = Step
+14 1 bits0-4:arp arpscale
+15 1 u8 arpcenter
+16 2 u16 mute
+18 2 u16 swingsw
+20 2 u16 outbus
+22 2 u16 accentsw
@sub drum 24 9 drum
@sub kbd 330 2 kbd
@sub slice 878 3 slice
@sub audioin 974 1 audioin
@sub accent 1130 1 accent
@sub fx 1148 3 fx
@sub motion 1160 24 motion
@end
@struct song 528
+0 8 str name
+8 2 tempo tempo
+10 1 u8 tempolock
+11 1 u8 length        # +1
+12 1 u8 mutehold
+13 1 u8 nextsong
+14 2 u16 events
+16 256 bytes patterns
+272 256 bytes noteoffsets
@end
@struct smono 40
+0 8 str name
+8 4 u32 off1start
+12 4 u32 off1end
+16 4 u32 start
+20 4 u32 end
+24 4 u32 loopstart
+28 4 u32 rate
+32 2 tune tune         # Halbtöne; 32-kHz-Samples tragen −5,55 (= 32000/44100)
+34 1 u8 playlevel
+36 1 s8 stretchstep
@end
@struct sstereo 44
+0 8 str name
+8 4 u32 off1start
+12 4 u32 off1end
+16 4 u32 off2start
+20 4 u32 off2end
+24 4 u32 start
+28 4 u32 end
+32 4 u32 rate
+36 2 tune tune
+38 1 u8 playlevel
+40 1 s8 stretchstep
@end
@audio 0x250000 16
@array pattern 0x000200 256 pattern
@array song 0x130000 64 song
@array smono 0x1B0100 256 smono
@array sstereo 0x1B2900 128 sstereo
0x000020 1 u8 memprotect
0x000022 1 u8 arpcontrol
0x000023 1 u8 audioinmode
0x000024 1 u8 midiclock
0x000026 1 u8 pitchbend
0x1B0020 4 u32 nummono
0x1B0024 4 u32 numstereo
